# AI Job Application Assistant Configuration

# Gemini API Key (Optional for basic demo mode, required for full LLM analysis)
# Obtain a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name
LLM_MODEL=gemini-1.5-flash

# Playwright MCP Server Executable & Arguments
# On Windows, npx runs as npx.cmd; on Linux/Mac, npx
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest --headless

# SQLite Database Location
DATABASE_PATH=data/jobs.db

# Built-in Demo Job Portal Port
DEMO_SERVER_PORT=8765

# Timeout in seconds for browser operations
BROWSER_TIMEOUT=60
